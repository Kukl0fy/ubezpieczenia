# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Session lifetime in seconds (default: 8 hours). Rejected when empty,
# non-numeric, or not positive. Sessions also expire when the browser closes
# and are refreshed on each authenticated request.
DJANGO_SESSION_COOKIE_AGE=28800

# PostgreSQL
# For Docker Compose, POSTGRES_HOST must be `db` (the Compose service name).
# For host-side commands against a local database, use 127.0.0.1.
POSTGRES_DB=ubezpieczenia
POSTGRES_USER=ubezpieczenia
POSTGRES_PASSWORD=ubezpieczenia_dev_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
